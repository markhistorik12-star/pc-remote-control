# 1. Ignorar todo en la raíz por defecto
/*

# 2. Permitir archivos y carpetas esenciales en la raíz
!.gitignore
!.gitattributes
!/README.md
!/appsettings.json
!/TokenVerifier.cs
!/scripts/
!/backend/
!/src/
!/TokenVerifier/

# Opcional: descomenta si quieres subir configuración de VS Code o plantilla env
# !.vscode/
# !.env.example

# 3. Ignorar artefactos de compilación, dependencias y secretos dentro de las carpetas permitidas
**/bin/
**/obj/
**/node_modules/
*.keystore
*.log
*.apk
*.exe
*.tmp
*.bak
.env

# 4. Ocultar notas, diagnósticos y archivos específicos dentro de cualquier subcarpeta
*Ejecucion.txt
*logAPK.txt
*CLAUDE kharpati.md
*CONNECTION_DIAGNOSTIC.md
*Cargo.toml
*Remote.md
*simplest_solution.md
*TokenVerefier.cs
# 5. Frontend (Capacitor/React): subir solo codigo fuente
!/frontend/
frontend/dist/
frontend/www/
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/capacitor-cordova-android-plugins/build/
frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/android/app/src/main/assets/capacitor.plugins.json
frontend/generate-keystore.sh

